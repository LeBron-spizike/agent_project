# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="就业规划智能问答系统"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
DASHSCOPE_API_KEY="your-dashscope-api-key"
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_MODEL=qwen-plus
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=true

# MCP 工具配置
# 百度地图 MCP（自建 FastMCP Server 包装百度地图 REST API，stdio 传输，无需额外运行时）
# AK 在 https://lbsyun.baidu.com 个人实名认证后免费申请；留空则自动禁用该工具集，Agent 仍可正常启动
BAIDU_MAP_MCP_ENABLED=true
BAIDU_MAP_AK="your-baidu-map-ak"
LONG_TERM_MEMORY_MODEL=qwen-plus
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-v4
LONG_TERM_MEMORY_EMBEDDING_DIMS=1024
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory_qwen_1024_v2

# RAG 知识库配置
# RAG_ENABLED=false 时完全关闭知识库（不建表检索、不注册工具）
RAG_ENABLED=true
# inject=每轮自动检索并注入 system prompt；tool=注册 knowledge_search 工具由 Agent 按需调用；off=关闭
RAG_MODE=inject
# 知识文档目录（.md/.txt），摄取时按文件 MD5 增量去重
RAG_KNOWLEDGE_DIR=data/knowledge
# Embedding 模型与维度（DashScope text-embedding-v4 支持 1024，需与建表时维度一致）
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMS=1024
# 分块参数（中文按段落/句读切分）
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
# 检索返回条数与相似度阈值（0-1，0 表示不过滤）
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.0
# 应用启动时自动增量摄取知识目录（MD5 相同自动跳过）
RAG_AUTO_INGEST=true
RAG_INGEST_BATCH_SIZE=16
# RAG 二阶段精排：先向量召回候选窗口，再用 DashScope gte-rerank 精排到 top-k。
# 百炼新账号开通的是新版 gte-rerank-v2（老模型名 gte-rerank 已不再授权，调用返回 403）。
# 未开通模型额度时接口失败会自动降级为纯向量结果，不影响对话。
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=gte-rerank-v2
RAG_RERANK_CANDIDATES=20
RAG_RERANK_TOP_K=4
# 对话文件分析：单文件大小上限（MB）与提取文本最大字符数
ANALYZE_MAX_FILE_MB=10
ANALYZE_MAX_CHARS=6000
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text
